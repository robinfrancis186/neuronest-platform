# Local development configuration. Copy to .env and replace every placeholder.
COMPOSE_PROJECT_NAME=neuronest
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=generate-locally
POSTGRES_PASSWORD=generate-locally
RABBITMQ_PASSWORD=generate-locally
ENGINE_SERVICE_TOKEN=generate-locally
LIVEKIT_API_KEY=neuronest-local
LIVEKIT_API_SECRET=generate-locally
# Firebase Auth is the identity provider. The API key is a public project
# identifier used by the username sign-in bridge; the service account stays server-only.
IDENTITY_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
# One-line service-account JSON. Never copy this into either client .env file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Core production: set true only after verifying the deployed trusted proxy
# supplies a non-user-controlled client address (Vercel uses X-Vercel-Forwarded-For).
# Username sign-in fails closed in production until this is enabled there. Keep false locally.
TRUST_PROXY_HEADERS=false
# Core only. Leave blank locally to derive an HMAC key from DJANGO_SECRET_KEY;
# use a separate random server-only value in production so it can be rotated.
USERNAME_RATE_LIMIT_HMAC_KEY=
# Supabase remains the managed PostgreSQL, private-storage, and cron platform.
# Configure its DATABASE_URL, S3_*, and OUTBOX_* values only in the core host.
WEB_ORIGIN=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
