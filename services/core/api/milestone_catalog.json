            "ml": "മറ്റു കുട്ടികളോടൊപ്പം കളിക്കുമ്പോൾ ഊഴമെടുക്കുകയോ നിയമങ്ങൾ പാലിക്കുകയോ ചെയ്യുന്നു"
          }
        },
        {
          "id": "60m-2",
          "domain": "communication",
          "label": {
            "en": "Tells a story with at least two events",
            "ml": "രണ്ട് സംഭവങ്ങളെങ്കിലും ഉള്ള കഥ പറയുന്നു"
          }
        },
        {
          "id": "60m-3",
          "domain": "communication",
          "label": {
            "en": "Keeps a conversation going for more than three exchanges",
            "ml": "മൂന്നിലധികം തവണ മാറിമാറി സംഭാഷണം തുടരുന്നു"
          }
        },
        {
          "id": "60m-4",
          "domain": "cognitive",
          "label": {
            "en": "Counts up to ten",
            "ml": "പത്ത് വരെ എണ്ണുന്നു"
          }
        },
        {
          "id": "60m-5",
          "domain": "movement",
          "label": {
            "en": "Hops using one foot",
            "ml": "ഒറ്റക്കാലിൽ ചാടുന്നു"
          }
        },
        {
          "id": "60m-6",
          "domain": "daily_living",
          "label": {
            "en": "Fastens some buttons",
            "ml": "ചില ബട്ടണുകൾ ഇടുന്നു"
          }
        }
      ]
