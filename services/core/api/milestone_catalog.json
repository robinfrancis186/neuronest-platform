      "items": [
        {
          "id": "36m-1",
          "domain": "social",
          "label": {
            "en": "Notices other children and joins their play",
            "ml": "മറ്റു കുട്ടികളെ ശ്രദ്ധിച്ച് അവരുടെ കളിയിൽ ചേരുന്നു"
          }
        },
        {
          "id": "36m-2",
          "domain": "communication",
          "label": {
            "en": "Has a conversation with at least two back-and-forth exchanges",
            "ml": "രണ്ടു തവണയെങ്കിലും മാറിമാറി സംസാരിക്കുന്നു"
          }
        },
        {
          "id": "36m-3",
          "domain": "communication",
          "label": {
            "en": "Usually speaks clearly enough for others to understand",
            "ml": "പൊതുവേ മറ്റുള്ളവർക്ക് മനസ്സിലാകുന്ന വിധം സംസാരിക്കുന്നു"
          }
        },
        {
          "id": "36m-4",
          "domain": "cognitive",
          "label": {
            "en": "Copies a circle after you show how",
            "ml": "കാണിച്ചുകൊടുത്താൽ വൃത്തം വരയ്ക്കുന്നു"
          }
        },
        {
          "id": "36m-5",
          "domain": "movement",
          "label": {
            "en": "Threads large beads or similar items",
            "ml": "വലിയ മുത്തുകളോ സമാന വസ്തുക്കളോ കോർക്കുന്നു"
          }
        },
        {
          "id": "36m-6",
          "domain": "daily_living",
          "label": {
            "en": "Uses a fork to eat",
            "ml": "ഫോർക്ക് ഉപയോഗിച്ച് കഴിക്കുന്നു"
          }
        }
      ]
    },
    {
      "months": 48,
