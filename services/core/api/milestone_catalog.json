          "domain": "social",
          "label": {
            "en": "Comforts someone who is hurt or sad",
            "ml": "വേദനയോ വിഷമമോ ഉള്ള ഒരാളെ ആശ്വസിപ്പിക്കുന്നു"
          }
        },
        {
          "id": "48m-2",
          "domain": "communication",
          "label": {
            "en": "Uses sentences of at least four words",
            "ml": "നാലു വാക്കുകളെങ്കിലും ഉള്ള വാക്യങ്ങൾ പറയുന്നു"
          }
        },
        {
          "id": "48m-3",
          "domain": "communication",
          "label": {
            "en": "Talks about something that happened that day",
            "ml": "അന്ന് സംഭവിച്ച ഒരു കാര്യത്തെക്കുറിച്ച് സംസാരിക്കുന്നു"
          }
        },
        {
          "id": "48m-4",
          "domain": "cognitive",
          "label": {
            "en": "Names a few colours",
            "ml": "ഏതാനും നിറങ്ങളുടെ പേരുകൾ പറയുന്നു"
          }
        },
        {
          "id": "48m-5",
          "domain": "movement",
          "label": {
            "en": "Usually catches a large ball",
            "ml": "വലിയ പന്ത് സാധാരണയായി പിടിക്കുന്നു"
          }
        },
        {
          "id": "48m-6",
          "domain": "daily_living",
          "label": {
            "en": "Opens some buttons on clothing",
            "ml": "വസ്ത്രത്തിലെ ചില ബട്ടണുകൾ അഴിക്കുന്നു"
          }
        }
      ]
    },
    {
