# Use your HTTPS core API; a device cannot use your computer's localhost address.
EXPO_PUBLIC_API_URL=https://api.example.com
# Copy the Web app configuration from Firebase project settings. These are public
# app identifiers, not server credentials; leave server keys out of this file.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Required only for push enrollment after configuring EAS FCM/APNs credentials.
EXPO_PUBLIC_EAS_PROJECT_ID=
