# Public browser configuration only. Firebase's web API key identifies the project;
# never put a Firebase Admin key, service-account JSON, or core secret here.
VITE_API_URL=https://api.example.com
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:1234567890:web:replace-with-web-app-id
# VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
